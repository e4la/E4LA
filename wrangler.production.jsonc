{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "e4la",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-08-20",
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_SITE_URL": "https://www.e4la.org"
  },
  "d1_databases": [
    {
      "binding": "ENROLLMENT_DB",
      "database_name": "e4la-client-operations-production",
      "database_id": "0f358dd1-ae8c-485c-a996-aaeb890f195d"
    }
  ]
}
