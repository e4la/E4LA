# Documentation only. Never store actual credentials in this file.
ENVIRONMENT=preview
PUBLIC_SITE_URL=https://e4la-client-operations-preview.pages.dev
ENROLLMENT_DB=e4la-client-operations-preview
ENROLLMENT_SESSION_SECRET=SET_AS_ENCRYPTED_CLOUDFLARE_SECRET

# Cloudflare Access (unavailable until Access is enabled for the account)
ACCESS_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
ADMIN_ACCESS_AUD=SET_AFTER_ADMIN_ACCESS_APPLICATION_EXISTS
CLIENT_ACCESS_AUD=SET_AFTER_CLIENT_ACCESS_APPLICATION_EXISTS

# Stripe Sandbox/Test Mode only
STRIPE_SECRET_KEY=SET_AS_ENCRYPTED_CLOUDFLARE_SECRET
STRIPE_WEBHOOK_SECRET=SET_AS_ENCRYPTED_CLOUDFLARE_SECRET
STRIPE_API_VERSION=CONFIRM_IN_STRIPE_WORKBENCH
STRIPE_PORTAL_CONFIGURATION_ID=SET_FROM_TEST_PORTAL_CONFIGURATION
